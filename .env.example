# Banco administrativo: usado exclusivamente pelo Alembic.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=public_data
DB_ADMIN_USER=postgres_admin
DB_ADMIN_PASSWORD=change_me_admin

# Usuário usado pelo pipeline do extrator.
EXTRACTOR_DB_USER=extractor_user
EXTRACTOR_DB_PASSWORD=change_me_extractor

# Usuário usado exclusivamente pelo servidor MCP.
MCP_DB_USER=mcp_readonly
MCP_DB_PASSWORD=change_me_readonly

# API oficial da Câmara dos Deputados.
SOURCE_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
SOURCE_DEPUTIES_PATH=/deputados?ordem=ASC&ordenarPor=nome&itens=100
HTTP_CONNECT_TIMEOUT=5
HTTP_READ_TIMEOUT=30
HTTP_MAX_RETRIES=3

# Limites padrão das ferramentas MCP.
MCP_DEFAULT_LIMIT=20
MCP_MAX_LIMIT=100
